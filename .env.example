# Get a free key at https://ebird.org/api/keygen
EBIRD_API_KEY=your_ebird_api_key_here

# Exact display name shown on your eBird checklists
EBIRD_USER_DISPLAY_NAME=

# Home region for scanning recent checklists (e.g. US-FL-099 or US-TX)
EBIRD_HOME_REGION=US-FL-099

# Default hotspot locId on the Checklists screen
EBIRD_DEFAULT_HOTSPOT=L364884
