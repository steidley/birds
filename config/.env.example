# Get a free key at https://ebird.org/api/keygen
EBIRD_API_KEY=your_ebird_api_key_here
EBIRD_API_KEY_BACKUP=your_backup_ebird_api_key_here

# Exact display name shown on your eBird checklists (comma-separated aliases ok)
EBIRD_USER_DISPLAY_NAME=

# Home region for scanning recent checklists (e.g. US-FL-099 or US-TX)
EBIRD_HOME_REGION=US-FL-099

# Default hotspot locId on the Checklists screen
EBIRD_DEFAULT_HOTSPOT=L364884

# Optional path to a personal observations CSV (defaults to requiredData/MyBirdData.csv).
# MY_EBIRD_DATA_PATH=requiredData/MyBirdData.csv

# OpenRouteService — https://openrouteservice.org/dev/#/signup
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here
# Origin for Hot Spot Finder drive times (latitude / longitude)
ORS_HOME_LAT=26.6485226
ORS_HOME_LNG=-80.6388446
# Optional human-readable label (from GPS reverse-geocode or address lookup)
ORS_HOME_ADDRESS=
