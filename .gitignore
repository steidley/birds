# App config (secrets stay local; examples stay tracked).
config/.env
config/.env.*
!config/.env.example
config/streamlit/secrets.toml
!config/streamlit/secrets.toml.example
config/launch.html
config/recent_locations.json
# Legacy root locations (ignore if anything is left behind).
.env
.env.*
!.env.example
.streamlit/secrets.toml
!.streamlit/secrets.toml.example
/launch.html

# Cache tree: ignore by default; un-ignore deployable files below.
# Parent directories must be un-ignored before children can be.
cache/*
!cache/shared/
!cache/*/
cache/shared/**
cache/*/**

# Shared caches that ship with the repo.
!cache/shared/birdnet_code_cache.json
!cache/shared/ebird_region_list_cache.json
!cache/shared/ebird_region_species_cache.json
!cache/shared/ebird_taxonomy_cache.json
!cache/shared/inaturalist_cache.json
!cache/shared/inaturalist_gallery_cache.json
!cache/shared/inaturalist_similar_cache.json

# Per-region indexes / hotspots previously tracked at the project root.
!cache/*/local_last_seen.json
!cache/*/hotspots.json

# Keep downloaded checklists local, except Duda Farms for key-free deploy tests.
!cache/*/checklists/
cache/*/checklists/**
!cache/US-FL-099/checklists/2025/
!cache/US-FL-099/checklists/2026/
!cache/US-FL-099/checklists/2026-08/
