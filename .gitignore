.DS_Store
node_modules/
dist/
build/
*.log
.idea/
.vscode/
.venv/
venv/
__pycache__/
*.pyc
saved_galleries/

# App config (secrets stay local; examples stay tracked).
config/.env
config/.env.*
!config/.env.example
config/streamlit/secrets.toml
!config/streamlit/secrets.toml.example
config/launch.html
config/recent_locations.json
# Legacy root locations (ignore if anything is left behind).
.env
.env.*
!.env.example
.streamlit/secrets.toml
!.streamlit/secrets.toml.example
/launch.html

# Cache tree: ignore by default; un-ignore deployable zip sidecars below.
# Parent directories must be un-ignored before children can be.
# Expanded JSON / checklist trees stay local; pack with
# ``scripts/pack_shipped_cache.py pack`` before check-in.
cache/*
!cache/shared/
!cache/*/
cache/shared/**
cache/*/**

# Shared caches that ship with the repo (compressed).
!cache/shared/*.json.zip

# Per-region indexes / hotspots (compressed).
!cache/*/local_last_seen.json.zip
!cache/*/hotspots.json.zip

# Keep downloaded checklists local, except Duda Farms sample zips.
!cache/*/checklists/
cache/*/checklists/**
!cache/US-FL-099/checklists/
cache/US-FL-099/checklists/**
!cache/US-FL-099/checklists/2025/
!cache/US-FL-099/checklists/2026/
!cache/US-FL-099/checklists/2026-08/
cache/US-FL-099/checklists/2025/**
cache/US-FL-099/checklists/2026/**
cache/US-FL-099/checklists/2026-08/**
!cache/US-FL-099/checklists/2025/L364884.zip
!cache/US-FL-099/checklists/2026/L364884.zip
!cache/US-FL-099/checklists/2026-08/L364884.zip

# Legacy root-level cache filenames (ignore if anything is left behind).
/.ebird_api_throttle
/ebird_*_checklists_*.json
/ebird_*_year_first_*.json
/ebird_recent_regions.json
/ebird_last_seen_cache.json
/ebird_own_recent_sightings.json
/ebird_*_checklist_cache_status_*.json
/ebird_*_feed_cache_progress_*.json
/ebird_*_checklist_download_progress_*.json
/ebird_checklists/
